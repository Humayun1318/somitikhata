# Copy to .env.local and adjust. Every variable is explained in docs/ENVIRONMENT.md.
# Only NEXT_PUBLIC_* variables exist here: they are built into the browser bundle,
# so never put a secret in this file.

# Base URL of the SomitiKhata API, including /api/v1 (the backend's default port is 5000).
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api/v1

# Public address of this site, used for canonical links, sitemap and share cards.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
